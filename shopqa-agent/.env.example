# Chọn nhà cung cấp và model (LLM_MODEL là bắt buộc)
LLM_PROVIDER=google           # anthropic | google | ollama | openai
LLM_MODEL=

# Khóa API của nhà cung cấp bạn chọn (không cần với ollama)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Cấu hình agent
SHOPQA_HEADLESS=1             # 0 để xem trình duyệt chạy thật
SHOPQA_TIMEOUT_MS=5000
SHOPQA_ARTIFACTS=artifacts
SHOPQA_MAX_TESTS=6
SHOPQA_LLM_TIMEOUT=60         # số giây chờ tối đa cho mỗi lần gọi LLM
SHOPQA_LLM_RETRIES=2          # tăng lên (vd 5) khi Gemini hay báo quá tải; để 0-1 khi bị hết hạn mức (429)

# Langfuse (tùy chọn): điền cả hai khóa để bật trace; để trống thì agent chạy không trace
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com    # project ở vùng Mỹ: https://us.cloud.langfuse.com
# SHOPQA_TRACING=0            # bỏ dấu # để tắt trace tạm thời mà không cần xóa khóa
